# Copy this file to .env (gitignored) and fill in real values.
# Linode Personal Access Token, scoped read/write to: Linodes, Volumes, and IPs. Add VPCs
# (Read) too if any managed instance uses a VPC interface (find_vpc_id_for_subnet() needs it to
# resolve a subnet to its VPC ID). Account (Read Only) is enough to satisfy the tool's own
# startup check. No broader scope is needed -- a full-access token works but grants far more
# than this tool ever uses. Used by the CLI, the poller (`poll`), and the API server
# (`serve-api`) alike -- the one credential that actually talks to Linode.
# Create one at: Cloud Manager -> Profile -> API Tokens -> Create a Personal Access Token
LINODE_API_TOKEN=

# Only needed to run the customer-facing API server (`serve-api` / api_server.py, roadmap
# phase 8) with OAuth ("Login with Linode") enabled -- the CLI and poller never read these.
# Each deployment registers its OWN OAuth Client, in its OWN Linode account (self-hosted,
# one deployment per customer account -- NOT a shared service this project
# operates. Register one at: Cloud Manager -> Profile -> OAuth Apps -> Create an App. This is a
# SEPARATE credential from LINODE_API_TOKEN above -- it only ever identifies who's calling this
# API, never used to call Linode's own API directly (see api_server.py's own module docstring).
LINODE_OAUTH_CLIENT_ID=
LINODE_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI configured on the OAuth App above, e.g.
# https://your-deployment-host/oauth/callback
LINODE_OAUTH_REDIRECT_URI=

# Optional -- the SSH key serve-api uses for start/stop reachability checks, same default the
# CLI's own --ssh-key already uses if unset.
LINODE_SSH_KEY_PATH=

# Optional -- cap on Linode API requests per second made by one process of this tool (every
# parallel `poll` worker shares the same cap). A rate-limited (HTTP 429) response also pauses
# every worker for as long as the API asks. Default 10; set 0 to remove the cap (the shared
# pause on 429 still applies).
LINODE_API_MAX_REQUESTS_PER_SECOND=

# Optional -- days the dashboard's Activity entries are kept (default 30).
ACTIVITY_LOG_RETENTION_DAYS=

# Optional -- comma-separated origins allowed to call the API from a browser (CORS). Leave unset
# to disable CORS entirely (the default -- appropriate unless a browser-based dashboard needs to
# call this API cross-origin).
API_ALLOWED_ORIGINS=

# Optional -- Object Storage backup of each instance's full local record (network config, SSH
# keys, plan/firewall/etc. attributes) for disaster recovery beyond what Linode's own resource
# tags can hold. Also stores every pre-stop hook / post-start check (including uploaded scripts)
# so `rebuild` can restore them after losing the local database. Entirely opt-in: leave all four unset and this feature never activates, no
# extra credential or dependency cost. All four must be set together or none take effect. See
# object_storage_backup.py's own module docstring and CLAUDE.md's "Decided: hybrid tag + Object
# Storage backup" section for the full design.
# Create a bucket at: Cloud Manager -> Object Storage -> Create Bucket. Access keys: Object
# Storage -> Access Keys -> Create Access Key (scope it to this one bucket, not account-wide).
LINODE_OBJ_STORAGE_BUCKET=
# e.g. https://<bucket>.<region>.linodeobjects.com or the region-only endpoint form, per
# Cloud Manager's own bucket details page.
LINODE_OBJ_STORAGE_ENDPOINT=
LINODE_OBJ_STORAGE_ACCESS_KEY=
LINODE_OBJ_STORAGE_SECRET_KEY=

# The passphrase that encrypts the stored copies of the deployment SSH key (in the database and
# every backup, and in Object Storage). install.sh generates it on a first install. Its recovery
# copy is kept in a private StackScript in your Linode account, so a replacement host fetches it
# with the API token (the token needs StackScripts read/write). At least 12 characters.
LIS_SSH_KEY_PASSPHRASE=

# Optional -- old database snapshots in Object Storage: every one from the last N hours is kept
# (default 48), then one a day for N days (default 30), then none.
LIS_BACKUP_KEEP_ALL_HOURS=
LIS_BACKUP_KEEP_DAILY_DAYS=

# Optional -- alerts when the scheduler stops, backups fail, the deployment key isn't stored in
# every place, or nodes stay off their schedule. Either or both channels.
# Webhook: receives a JSON POST {"text", "event", "details", "host"} (Slack and Teams incoming
# webhooks accept it as is).
LIS_ALERT_WEBHOOK_URL=
# Email: comma-separated recipients plus an SMTP server. Linode blocks outbound SMTP ports on new
# accounts until you ask support to open them; a mail provider on another port works too.
LIS_ALERT_EMAIL_TO=
LIS_ALERT_SMTP_HOST=
# 587 for starttls (default), 465 for ssl
LIS_ALERT_SMTP_PORT=
# starttls (default) | ssl | none
LIS_ALERT_SMTP_SECURITY=
LIS_ALERT_SMTP_USER=
LIS_ALERT_SMTP_PASSWORD=
LIS_ALERT_EMAIL_FROM=
